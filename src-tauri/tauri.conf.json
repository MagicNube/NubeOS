{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NubeOS",
  "version": "0.1.0",
  "identifier": "com.jesus.nubeos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1180,
        "height": 760,
        "minWidth": 850,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-window"]
    }
  },
  "bundle": { "active": true, "targets": "all" }
}
